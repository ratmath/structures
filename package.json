{
  "name": "@ratmath/structures",
  "version": "0.5.0",
  "description": "Abstract algebra for RatMath: finite groups, exact polynomials in several variables, Gröbner bases, ideals, quotient rings, polynomial systems solved exactly, the integers mod n and quadratic integer rings, presentations, abelian groups and modules over Q[x]",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs/llms.txt"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "bun test --timeout 60000 ./tests",
    "docs:build": "bun scripts/build-docs.js && node scripts/build-llms.mjs",
    "docs:llms": "node scripts/build-llms.mjs"
  },
  "keywords": [
    "polynomial",
    "multivariate",
    "exact",
    "rational-function",
    "resultant",
    "gcd",
    "abstract-algebra",
    "group-theory",
    "finite-groups",
    "sylow",
    "burnside",
    "groebner-basis",
    "ideals",
    "polynomial-systems",
    "quadratic-integers",
    "class-group"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ratmath/structures.git"
  },
  "homepage": "https://ratmath.com/structures/",
  "dependencies": {
    "@ratmath/algebraic": "^0.1.0"
  },
  "peerDependencies": {
    "@ratmath/core": ">=0.10.0 <0.12.0"
  },
  "types": "index.d.ts",
  "workspaces": [
    "vendor/algebraic",
    "vendor/linalg"
  ],
  "devDependencies": {
    "@ratmath/core": "^0.11.0",
    "@ratmath/linalg": "^0.1.0",
    "katex": "0.19.1"
  },
  "author": "James Taylor",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/ratmath/structures/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
